<HxCard>
	<HeaderTemplate>
		<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
			<div>
				<span>02 · Přehledová tabulka</span>
				<span class="ms-2 text-muted" style="text-transform:none; letter-spacing:0;">
					@sorted[0].UcetniZaverka.NazevSpolecnosti · IČO @sorted[0].UcetniZaverka.Ico · tis.&nbsp;Kč
				</span>
			</div>
			<div class="d-flex gap-3 align-items-center" style="font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase;">
				<span><span class="legend-dot ok"></span>Y/Y konzistentní</span>
				<span><span class="legend-dot ok"></span><span class="c-ok-sign px-1">jen znaménko</span></span>
				<span><span class="legend-dot warn"></span>odchylka Y/Y</span>
				<span><span class="legend-dot bad"></span>nebalancuje</span>
			</div>
		</div>
	</HeaderTemplate>
	<BodyTemplate>
		<div class="table-responsive">
			<table class="table hx-grid cross-year-table mb-0" style="width: auto; min-width: 100%;">
				<thead>
					<tr>
						<th style="width: 5rem;">Ozn.</th>
						<th>Položka</th>
						@foreach (var r in sorted)
						{
							<th class="text-end" style="min-width: 9rem;">
								<div class="font-display" style="font-size: 1.6rem; line-height: 1; color: var(--ink); font-variation-settings: 'opsz' 144;">@r.Rok</div>
								<div class="text-muted" style="font-size: 0.65rem; letter-spacing: 0.08em;">
									@System.IO.Path.GetFileNameWithoutExtension(r.SourceFile)
								</div>
							</th>
						}
					</tr>
				</thead>
				<tbody>
					@* Validation snapshot *@
					<tr class="row-section-header"><td colspan="@(2 + sorted.Count)">Validace</td></tr>
					<tr>
						<td></td>
						<td>Rozvaha v rovnováze</td>
						@foreach (var r in sorted)
						{
							<td class="text-end">
								<span class="status-pill @(r.JeRozvahaVRovnovaze ? "ok" : "bad")">
									@(r.JeRozvahaVRovnovaze ? "✓" : "✗") @(r.JeRozvahaVRovnovaze ? "ANO" : "NE")
								</span>
							</td>
						}
					</tr>
					<tr>
						<td></td>
						<td>VH konzistentní</td>
						@foreach (var r in sorted)
						{
							<td class="text-end">
								<span class="status-pill @(r.JeVHKonzistentni ? "ok" : "bad")">
									@(r.JeVHKonzistentni ? "✓" : "✗") @(r.JeVHKonzistentni ? "ANO" : "NE")
								</span>
							</td>
						}
					</tr>

					@* Aktiva *@
					<tr class="row-section-header"><td colspan="@(2 + sorted.Count)">Rozvaha · Aktiva (Netto)</td></tr>
					@foreach (var row in AktivaRows())
					{
						<tr class="@(row.IsTotal ? "row-total" : "")">
							<td class="font-mono small">@row.Oznaceni</td>
							<td>@row.Nazev</td>
							@for (int i = 0; i < sorted.Count; i++)
							{
								var r = sorted[i];
								var value = row.GetBezne(r.UcetniZaverka.Aktiva);
								var reportedPrev = row.GetMinule(r.UcetniZaverka.Aktiva);
								var actualPrev = i > 0 ? row.GetBezne(sorted[i - 1].UcetniZaverka.Aktiva) : (decimal?)null;
								var hardError = row.IsTotal && row.Oznaceni == "" && !r.JeRozvahaVRovnovaze;
								var c = Classify(actualPrev, reportedPrev, hardError);
								<td class="cell-num @c.Css" title="@c.Hint">@Fmt(value)</td>
							}
						</tr>
					}

					@* Pasiva *@
					<tr class="row-section-header"><td colspan="@(2 + sorted.Count)">Rozvaha · Pasiva (Běžné)</td></tr>
					@foreach (var row in PasivaRows())
					{
						<tr class="@(row.IsTotal ? "row-total" : "")">
							<td class="font-mono small">@row.Oznaceni</td>
							<td>@row.Nazev</td>
							@for (int i = 0; i < sorted.Count; i++)
							{
								var r = sorted[i];
								var value = row.GetBezne(r.UcetniZaverka.Pasiva);
								var reportedPrev = row.GetMinule(r.UcetniZaverka.Pasiva);
								var actualPrev = i > 0 ? row.GetBezne(sorted[i - 1].UcetniZaverka.Pasiva) : (decimal?)null;
								var hardError = row.IsTotal && row.Oznaceni == "" && !r.JeRozvahaVRovnovaze;
								var c = Classify(actualPrev, reportedPrev, hardError);
								<td class="cell-num @c.Css" title="@c.Hint">@Fmt(value)</td>
							}
						</tr>
					}

					@* VZZ *@
					<tr class="row-section-header"><td colspan="@(2 + sorted.Count)">Výkaz zisku a ztráty (Běžné)</td></tr>
					@foreach (var row in VzzRows())
					{
						<tr class="@(row.IsTotal ? "row-total" : "")">
							<td class="font-mono small">@row.Oznaceni</td>
							<td>@row.Nazev</td>
							@for (int i = 0; i < sorted.Count; i++)
							{
								var r = sorted[i];
								var value = row.GetBezne(r.UcetniZaverka.VykazZiskuAZtraty);
								var reportedPrev = row.GetMinule(r.UcetniZaverka.VykazZiskuAZtraty);
								var actualPrev = i > 0 ? row.GetBezne(sorted[i - 1].UcetniZaverka.VykazZiskuAZtraty) : (decimal?)null;
								var hardError = row.Oznaceni == "***" && !r.JeVHKonzistentni;
								var c = Classify(actualPrev, reportedPrev, hardError);
								<td class="cell-num @c.Css" title="@c.Hint">@Fmt(value)</td>
							}
						</tr>
					}

					@* Metrics *@
					<tr class="row-section-header"><td colspan="@(2 + sorted.Count)">API metriky</td></tr>
					<tr>
						<td></td><td>Celkový čas</td>
						@foreach (var r in sorted) { <td class="cell-num">@(r.Metrics?.TotalDuration.TotalSeconds.ToString("F1") ?? "?")&nbsp;s</td> }
					</tr>
					<tr>
						<td></td><td>GPT-5.1 volání</td>
						@foreach (var r in sorted) { <td class="cell-num">@(r.Metrics?.GptCalls ?? 0)</td> }
					</tr>
					<tr>
						<td></td><td>GPT-5.1 tokeny celkem</td>
						@foreach (var r in sorted) { <td class="cell-num">@(r.Metrics?.GptTotalTokens.ToString("N0") ?? "?")</td> }
					</tr>
					<tr>
						<td></td><td>Opakování validace</td>
						@foreach (var r in sorted) { <td class="cell-num">@(r.Metrics?.BalanceRetries ?? 0)</td> }
					</tr>
				</tbody>
			</table>
		</div>
	</BodyTemplate>
</HxCard>
